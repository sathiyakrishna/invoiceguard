# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (use a separate project with a monthly budget limit)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public site URL (your Vercel URL, no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Limits for regular users
LIMIT_SCANS_DAY=3
LIMIT_SCANS_MONTH=10
LIMIT_AI_DAY=50
LIMIT_AI_MONTH=200
# Limits for judge demo accounts
DEMO_LIMIT_SCANS_DAY=10
DEMO_LIMIT_AI_DAY=300
# Limits for the shared test account (scripts/create-tester.mjs)
TESTER_LIMIT_SCANS_DAY=10
TESTER_LIMIT_AI_DAY=100
TESTER_LIMIT_SCANS_MONTH=30
TESTER_LIMIT_AI_MONTH=300
# All users together, per day (IST)
LIMIT_AI_GLOBAL_DAY=1500

# Protects the daily cleanup job (any long random string)
CRON_SECRET=

# Only used by scripts/create-demo-users.mjs
DEMO_PASSWORD_1=
DEMO_PASSWORD_2=
DEMO_PASSWORD_3=
DEMO_EMAIL_DOMAIN=invoiceguard.app

# Only used by scripts/create-tester.mjs and reset-tester.mjs: an inbox you own (a plus-alias works), e.g. you+tester@gmail.com
TESTER_EMAIL=
